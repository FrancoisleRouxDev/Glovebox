# Copy to `.env` and set your computer's LAN IP (NOT localhost: on a phone,
# "localhost" means the phone itself). Find it with `ipconfig` (Windows) or
# `ipconfig getifaddr en0` (macOS). Restart `npx expo start` after changing it.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# Everything prefixed EXPO_PUBLIC_ is baked into the app bundle and visible to
# anyone who has the app, so never put secrets (like AI API keys) here.
