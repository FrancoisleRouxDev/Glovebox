# Copy this file to `.env` and fill in your API keys.
# Model IDs and base URLs were checked against the provider docs on 2026-11-01.
# Providers retire models regularly. If calls start failing with "model not found",
# check the links below and update the IDs here. No code changes are needed.

# --- Groq ---------------------------------------------------------------------
# Keys:   https://console.groq.com/keys
# Models: https://console.groq.com/docs/vision
# Note: meta-llama/llama-4-scout-17b-16e-instruct was shut down on 2026-07-17.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Ask the API to guarantee a JSON object response (Groq supports this with images).
GROQ_JSON_MODE=true
# Extra provider-specific request fields, as JSON. This Qwen model "thinks" by default.
# "none" turns that off, which makes it faster and keeps the output to plain JSON.
GROQ_EXTRA_BODY={"reasoning_effort": "none"}

# --- NVIDIA NIM (hosted API catalog) -------------------------------------------
# Keys:   https://build.nvidia.com (any model page -> "Get API Key")
# Models: run `curl https://integrate.api.nvidia.com/v1/models` to list them.
# Note: nvidia/llama-3.1-nemotron-nano-vl-8b-v1 is not served by the hosted API.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# JSON mode support varies by NIM model, so we rely on the prompt + parsing instead.
NVIDIA_JSON_MODE=false
# Turn off Nemotron's reasoning mode so it answers with JSON directly.
NVIDIA_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# --- Behaviour ----------------------------------------------------------------
# Which provider to try first: "groq" or "nvidia". The other is the fallback.
PRIMARY_PROVIDER=groq
# Seconds to wait for a single model call before giving up.
REQUEST_TIMEOUT_S=30
# Largest upload /identify accepts, in megabytes.
MAX_UPLOAD_MB=10
# Wikipedia asks API clients to identify themselves: https://meta.wikimedia.org/wiki/User-Agent_policy
WIKIPEDIA_USER_AGENT=CarSpotter/0.1 (learning project; contact: you@example.com)
LOG_LEVEL=INFO
